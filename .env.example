# All defaults work with zero third-party signups (spec Section 3).
CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com        # public default; Helius optional
HELIUS_API_KEY=                              # optional; features degrade gracefully
PROTOCOL_LAUNCH_FEE_LAMPORTS=50000000        # 0.05 SOL default, operator-tunable
PROTOCOL_SHARE_BPS=1000                      # only used if GATE 0c passes
ARTIFACT_STORE=sqlite:.data/artifacts.db     # sim/decode artifacts (spec 12.3)

# --- Launchpad backend (packages/backend/src/server.ts) ---
PORT=4500
LAUNCHPAD_PROGRAM_ID=6s4F21hxm5MurkGX6XdfcbPtMPXMxVfazATZRsiRrmvr  # scaffold; real id at first devnet deploy (D-039)
LAUNCHPAD_STORE=sqlite:.data/launchpad.db    # coins/trades/cursor index
INDEXER_POLL_MS=4000                         # 4s fits Helius free 1M credits/mo
SSE_HEARTBEAT_MS=25000                        # under Railway's 5-min no-data cutoff
CORS_ORIGINS=                                 # comma-separated exact frontend origins (empty = none)
RPC_PROXY_UPSTREAM=                           # e.g. https://devnet.helius-rpc.com/?api-key=KEY (key stays server-side)
METADATA_DIR=.data/meta                       # self-hosted token metadata assets
PUBLIC_BASE_URL=http://localhost:4500         # absolute base the metadata URIs are built from
KEEPER_KEYPAIR=                               # base58 or JSON array; fee-payer only, ~2 devnet SOL (empty = no keeper)
AIRDROP_ENABLED=0                             # 1 to expose POST /launchpad/airdrop
AIRDROP_SOL=1
AIRDROP_COOLDOWN_HOURS=8
AIRDROP_DAILY_CAP=200
